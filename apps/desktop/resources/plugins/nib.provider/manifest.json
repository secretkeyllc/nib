{
  "schemaVersion": 1,
  "id": "nib.provider",
  "name": "Nib",
  "version": "1.0.0",
  "description": "Sign in with a Nib account and route requests through the Nib gateway.",
  "i18n": {
    "en": {
      "name": "Nib",
      "description": "Sign in with a Nib account and route requests through the Nib gateway."
    },
    "zh-CN": {
      "name": "Nib",
      "description": "使用 Nib 账号登录，并通过 Nib 网关发起请求。"
    }
  },
  "author": "Secret Key LLC",
  "homepage": "https://sknib.com",
  "main": "main.js",
  "contributes": {
    "providers": [
      {
        "id": "nib",
        "name": "Nib",
        "category": "Nib",
        "description": "Every major model family on one subscription.",
        "vendorKey": "custom",
        "baseUrl": "https://sknib.com/v1",
        "apiStyle": "chat_completions",
        "authKind": "oauth",
        "oauth": {
          "loginLabel": "Sign in with Nib",
          "isSubscription": true
        },
        "models": [
          {
            "id": "nib-efficient",
            "name": "Nib Efficient",
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "nib-standard",
            "name": "Nib Standard",
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "nib-frontier",
            "name": "Nib Frontier",
            "contextWindow": 400000,
            "maxTokens": 32768
          }
        ]
      }
    ],
    "views": [
      {
        "id": "usage",
        "title": {
          "en": "Nib usage",
          "zh-CN": "Nib 用量"
        },
        "icon": "chart",
        "entry": "views/usage.html",
        "order": 5
      }
    ]
  },
  "permissions": [
    "provider.register",
    "net.http",
    "provider.oauth",
    "ui.view"
  ],
  "engines": {
    "piDesktop": ">=0.8.0"
  },
  "enabledByDefault": true
}
